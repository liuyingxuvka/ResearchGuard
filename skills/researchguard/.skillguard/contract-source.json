{
  "schema_version": "skillguard.skill_contract.v3",
  "skill_id": "researchguard",
  "maintenance_unit_id": "unit:researchguard-suite",
  "member_skill_ids": [
    "researchguard"
  ],
  "inputs": [
    {
      "id": "input:001",
      "path": "SKILL.md",
      "required": true,
      "role": "instructions"
    },
    {
      "id": "input:002",
      "path": "agents/openai.yaml",
      "required": true,
      "role": "runtime_source"
    },
    {
      "id": "input:003",
      "path": "references/external-domain-dna.md",
      "required": true,
      "role": "runtime_source"
    },
    {
      "id": "input:004",
      "path": "references/member-admission-index.md",
      "required": true,
      "role": "runtime_source"
    },
    {
      "id": "input:005",
      "path": "references/member-model-envelope.md",
      "required": true,
      "role": "runtime_source"
    },
    {
      "id": "input:wrapper",
      "path": ".skillguard/checks/run_researchguard_check.py",
      "required": true,
      "role": "author_check"
    }
  ],
  "routes": [
    {
      "route_id": "route:researchguard:current-validation",
      "choice_group": "operation",
      "when": [
        {
          "fact": "operation",
          "equals": "validate"
        }
      ],
      "step_ids": [
        "step:researchguard:consumer-contract",
        "step:researchguard:prompt-load",
        "step:researchguard:native-tests",
        "step:researchguard:task-model-closure"
      ],
      "obligation_ids": [
        "obligation:researchguard:consumer-contract",
        "obligation:researchguard:prompt-load",
        "obligation:researchguard:native-tests",
        "obligation:researchguard:task-model-closure",
        "obligation:researchguard:consumer-install-transaction"
      ]
    }
  ],
  "steps": [
    {
      "step_id": "step:researchguard:consumer-contract",
      "check_ids": [
        "check:researchguard:consumer-contract"
      ],
      "requires": []
    },
    {
      "step_id": "step:researchguard:prompt-load",
      "check_ids": [
        "check:researchguard:prompt-load"
      ],
      "requires": [
        "step:researchguard:consumer-contract"
      ]
    },
    {
      "step_id": "step:researchguard:native-tests",
      "check_ids": [
        "check:researchguard:native-tests"
      ],
      "requires": [
        "step:researchguard:prompt-load"
      ]
    },
    {
      "step_id": "step:researchguard:task-model-closure",
      "check_ids": [
        "check:researchguard:task-model-closure"
      ],
      "requires": [
        "step:researchguard:native-tests"
      ]
    }
  ],
  "obligations": [
    {
      "obligation_id": "obligation:researchguard:consumer-contract",
      "check_ids": [
        "check:researchguard:consumer-contract"
      ]
    },
    {
      "obligation_id": "obligation:researchguard:prompt-load",
      "check_ids": [
        "check:researchguard:prompt-load"
      ]
    },
    {
      "obligation_id": "obligation:researchguard:native-tests",
      "check_ids": [
        "check:researchguard:native-tests"
      ]
    },
    {
      "obligation_id": "obligation:researchguard:task-model-closure",
      "check_ids": [
        "check:researchguard:task-model-closure"
      ]
    },
    {
      "obligation_id": "obligation:researchguard:consumer-install-transaction",
      "check_ids": [
        "check:researchguard:native-tests"
      ]
    }
  ],
  "checks": [
    {
      "check_id": "check:researchguard:consumer-contract",
      "command": "{{python}}",
      "args": [
        ".skillguard/checks/run_researchguard_check.py",
        "consumer-contract"
      ],
      "expected": {
        "exit_code": 0
      },
      "input_ids": [
        "input:wrapper",
        "input:001",
        "input:002",
        "input:003",
        "input:004",
        "input:005"
      ],
      "timeout_seconds": 300,
      "kind": "command"
    },
    {
      "check_id": "check:researchguard:prompt-load",
      "command": "{{python}}",
      "args": [
        ".skillguard/checks/run_researchguard_check.py",
        "prompt-load"
      ],
      "expected": {
        "exit_code": 0
      },
      "input_ids": [
        "input:wrapper",
        "input:001",
        "input:002",
        "input:003",
        "input:004",
        "input:005"
      ],
      "timeout_seconds": 60,
      "kind": "command"
    },
    {
      "check_id": "check:researchguard:native-tests",
      "command": "{{python}}",
      "args": [
        ".skillguard/checks/run_researchguard_check.py",
        "native-tests"
      ],
      "expected": {
        "exit_code": 0
      },
      "input_ids": [
        "input:wrapper",
        "input:001",
        "input:002",
        "input:003",
        "input:004",
        "input:005"
      ],
      "timeout_seconds": 900,
      "kind": "command"
    },
    {
      "check_id": "check:researchguard:task-model-closure",
      "command": "{{python}}",
      "args": [
        ".skillguard/checks/run_researchguard_check.py",
        "task-model-closure"
      ],
      "expected": {
        "exit_code": 0
      },
      "input_ids": [
        "input:wrapper",
        "input:001",
        "input:002",
        "input:003",
        "input:004",
        "input:005"
      ],
      "timeout_seconds": 900,
      "kind": "command"
    }
  ],
  "consumer_projection": {
    "projection_id": "projection:consumer-distribution",
    "file_paths": [
      "SKILL.md",
      "agents/openai.yaml",
      "references/external-domain-dna.md",
      "references/member-admission-index.md",
      "references/member-model-envelope.md"
    ],
    "release_manifest_path": "consumer-release.json"
  }
}
